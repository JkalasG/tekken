# Copia este archivo como ".env" (cp .env.example .env) y cambia los valores.

# Clave del botón ⚙ del juego (reinicia la sala). OBLIGATORIA: pon una propia.
ADMIN_KEY=cambia_esta_clave

# Puerto del servidor donde se publica el juego
HOST_PORT=3000

# 0.0.0.0 = accesible desde afuera. 127.0.0.1 = solo desde el propio servidor (úsalo si hay Nginx delante).
BIND_ADDR=0.0.0.0

# Reglas (opcionales)
MAX_QUESTIONS=12
QUESTION_SECONDS=20

# --- Solo si usas nginx-proxy (quita el # de las 4 líneas y cambia los valores) ---
# COMPOSE_FILE=docker-compose.yml:docker-compose.proxy.yml
# DOMINIO=juego.tudominio.com
# PROXY_NETWORK=nginx-proxy
# LETSENCRYPT_EMAIL=tu@correo.com
